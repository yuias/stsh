{
  "name": "stsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply stsh-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply stsh-db --remote"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "hono": "^4.13.1",
    "jose": "^6.2.8",
    "marked": "^18.0.9",
    "shiki": "^4.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "wrangler": "^4.120.0"
  }
}
